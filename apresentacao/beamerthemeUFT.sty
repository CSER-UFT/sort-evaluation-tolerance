\mode<presentation>

\useoutertheme{infolines}
\useinnertheme{rectangles}

\definecolor{uftverde}{HTML}{00897C}
\definecolor{uftazul}{HTML}{005484}
\definecolor{uftciano}{HTML}{008AA3}
\definecolor{uftfaixa}{HTML}{E6E7E7}
\definecolor{uftbloco}{HTML}{F3F3F3}
\definecolor{uftamarelo}{RGB}{252,185,0}
\definecolor{uftcinza}{RGB}{134,135,137}

\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{structure}{fg=uftverde}
\setbeamercolor{alerted text}{fg=uftazul}
\setbeamercolor{frametitle}{fg=uftverde,bg=uftfaixa}
\setbeamercolor{title}{fg=white,bg=uftazul}
\setbeamercolor{subtitle}{fg=white}
\setbeamercolor{author}{fg=black}
\setbeamercolor{institute}{fg=black}
\setbeamercolor{date}{fg=black}

\setbeamercolor{section in head/foot}{fg=black,bg=uftverde}
\setbeamercolor{subsection in head/foot}{fg=white,bg=uftciano}
\setbeamercolor{author in head/foot}{fg=black,bg=uftverde}
\setbeamercolor{title in head/foot}{fg=white,bg=uftazul}
\setbeamercolor{date in head/foot}{fg=black,bg=uftciano}

\setbeamercolor{block title}{fg=white,bg=uftverde}
\setbeamercolor{block body}{fg=black,bg=uftbloco}
\setbeamercolor{block title alerted}{fg=white,bg=uftazul}
\setbeamercolor{block body alerted}{fg=black,bg=uftbloco}
\setbeamercolor{block title example}{fg=white,bg=uftciano}
\setbeamercolor{block body example}{fg=black,bg=uftbloco}

\setbeamercolor{item projected}{fg=white,bg=uftverde}
\setbeamercolor{section number projected}{fg=white,bg=uftverde}

\setbeamertemplate{background canvas}{%
  \includegraphics[width=\paperwidth,height=\paperheight]{fundo}}
\setbeamertemplate{section in toc}[sections numbered]

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.3em,dp=1em,leftskip=0.8em]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle
  \end{beamercolorbox}%
}

\def\insertadvisor{}
\newcommand{\advisor}[1]{\def\insertadvisor{#1}}

\setbeamertemplate{title page}{%
  \vspace*{-0.6em}
  \begin{center}
    \includegraphics[height=1.6cm]{logouft}
  \end{center}
  \vspace{0.2em}
  \begin{beamercolorbox}[wd=\textwidth,sep=0.7em,center]{title}%
    {\usebeamerfont{title}\inserttitle\par}%
    \ifx\insertsubtitle\@empty\else
      \vspace{0.3em}{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
    \fi
  \end{beamercolorbox}%
  \vspace{1em}
  \begin{center}
    {\usebeamerfont{author}\insertauthor\par}
    \ifx\insertadvisor\@empty\else
      \vspace{0.6em}{\footnotesize\textbf{Orientador:} \insertadvisor\par}
    \fi
    \vspace{0.6em}{\footnotesize\insertinstitute\par}
  \end{center}
}

\mode<all>
